# Copy this file to ".env" and edit the values.

# "local" = simulated cloud (a folder on your PC). No AWS account needed.
# "s3"    = real Amazon S3.
STORAGE_BACKEND=local

# Folder to back up
SOURCE_DIR=sample_source

# --- Only needed when STORAGE_BACKEND=s3 ---
S3_BUCKET=your-bucket-name
AWS_REGION=ap-south-1
# Leave these empty if you use `aws configure` or an EC2 IAM role
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Automatic backup every N minutes (0 = disabled, use the button instead)
BACKUP_INTERVAL_MINUTES=0

# Retry settings
MAX_RETRIES=3
BACKOFF_SECONDS=1

# DEMO: 0.0 to 1.0 = chance that a local upload fails. Use 0.5 to see
# failure patterns and AI advice on the dashboard.
# Demo failure rate (local mode only); Demo Lab can change this live.
SIMULATE_FAILURE_RATE=0

# Optional AI explanations (rule-based advice works without this)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Pattern detection: N failures of one type within H hours = "recurring"
PATTERN_THRESHOLD=3
PATTERN_WINDOW_HOURS=24

# --- Web security ---
# Local demo can use AUTH_ENABLED=false. For any cloud deployment, enable login.
APP_ENV=development
AUTH_ENABLED=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Generate a long random value for SECRET_KEY before deploying to a cloud host.
SECRET_KEY=change-me-in-production
COOKIE_SECURE=false
SESSION_MINUTES=60
