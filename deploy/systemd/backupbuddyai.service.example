[Unit]
Description=BackupBuddyAI Flask application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/opt/backupbuddyai
EnvironmentFile=/etc/backupbuddyai/backupbuddy.env
ExecStart=/opt/backupbuddyai/venv/bin/gunicorn --workers 1 --threads 4 --timeout 120 --bind 127.0.0.1:5000 app:app
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/backupbuddyai

[Install]
WantedBy=multi-user.target
